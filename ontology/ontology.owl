    <!-- http://qudt.org/schema/qudt/hasUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasUnit">
        <owl:inverseOf rdf:resource="http://qudt.org/schema/qudt/unitFor"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/unitFor -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/unitFor"/>
    


    <!-- http://schema.org/manufacturer -->

    <owl:ObjectProperty rdf:about="http://schema.org/manufacturer">
        <rdfs:range rdf:resource="http://schema.org/Organization"/>
        <rdfs:comment xml:lang="en">The manufacturer of the product.</rdfs:comment>
        <rdfs:label xml:lang="en">manufacturer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/censovehiculos#vehicleType -->

    <owl:ObjectProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/censovehiculos#vehicleType">
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="http://vocab.linkeddata.es/datosabiertos/kos/edint/VehicleType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Tipo de vehículo. Los valores son conceptos SKOS que pertenecen a una lista controlada de tipos de vehículos (por ejemplo, bicicleta, patinete, turismo, furgoneta, caravana, etc.).</rdfs:comment>
        <rdfs:comment xml:lang="en">Type of vehicle. The range is a SKOS concept that belongs to a controlled list of vehicle types (e.g., bicycle, scooter, van, truck, caravan, etc.).</rdfs:comment>
        <rdfs:label xml:lang="es">tipo de vehículo</rdfs:label>
        <rdfs:label xml:lang="en">vehicle type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#destinationDock -->

    <owl:ObjectProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#destinationDock">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#Route"/>
        <rdfs:range rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#Dock"/>
        <rdfs:comment xml:lang="es">El anclaje de una estación a donde finaliza una ruta de un vehículo.</rdfs:comment>
        <rdfs:comment xml:lang="en">The dock in a station where a vehicle&apos;s route ends.</rdfs:comment>
        <rdfs:label xml:lang="en">destination dock</rdfs:label>
        <rdfs:label xml:lang="es">tiene anclaje destino</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#destinationSpot -->

    <owl:ObjectProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#destinationSpot">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#Route"/>
        <rdfs:range rdf:resource="http://vocab.ciudadesabiertas.es/def/urbanismo-infraestructuras/aparcamiento#ParkingSpot"/>
        <rdfs:comment xml:lang="en">Parking spot where a vehicle&apos;s route ends.</rdfs:comment>
        <rdfs:comment xml:lang="es">Plaza de aparcamiento en donde finaliza la ruta de un vehículo.</rdfs:comment>
        <rdfs:label xml:lang="en">destination parking spot</rdfs:label>
        <rdfs:label xml:lang="es">plaza de aparcamiento estino</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#dockState -->

    <owl:ObjectProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#dockState">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#Dock"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="http://vocab.linkeddata.es/datosabiertos/kos/edint/DockState"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Indica si el anclaje está en servicio o fuera de servicio por alguna razón, por ejemplo, por mantenimiento.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates whether the dock is in service or out of service for any reason, for example, for maintenance.</rdfs:comment>
        <rdfs:label xml:lang="en">dock state</rdfs:label>
        <rdfs:label xml:lang="es">estado del anclaje</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#hasDock -->

    <owl:ObjectProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#hasDock">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#SharedVehicleStation"/>
        <rdfs:range rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#Dock"/>
        <rdfs:comment xml:lang="es">Relación entre una estación de vehículos compartidos y los anclajes que le pertenecen.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relationship between a shared vehicle siation and the docks that belong to it.</rdfs:comment>
        <rdfs:label xml:lang="en">has dock</rdfs:label>
        <rdfs:label xml:lang="es">tiene anclaje</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#hasWaypoint -->

    <owl:ObjectProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#hasWaypoint">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#Route"/>
        <rdfs:range rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#Waypoint"/>
        <rdfs:comment xml:lang="es">Enlace entre el trayecto y los puntos de paso. Los vehículos que dispongan de GPS indicarán los puntos de paso de un trayecto determinado.</rdfs:comment>
        <rdfs:comment xml:lang="en">Link from the route to the waypoints. Vehicles with GPS will indicate the waypoints of a certain route.</rdfs:comment>
        <rdfs:label xml:lang="en">has waypoint</rdfs:label>
        <rdfs:label xml:lang="es">tiene punto de paso</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#madeByVehicle -->

    <owl:ObjectProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#madeByVehicle">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#Route"/>
        <rdfs:range rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#SharedVehicle"/>
        <vann:preferredNamespaceUri xml:lang="es">Relación entre un trayecto y el vehículo que lo realiza.</vann:preferredNamespaceUri>
        <vann:preferredNamespaceUri xml:lang="en">Relationship between a route and the vehicle that makes it.</vann:preferredNamespaceUri>
        <rdfs:label xml:lang="en">made by vehicle</rdfs:label>
        <rdfs:label xml:lang="es">realizado por vehículo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#operatedBy -->

    <owl:ObjectProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#operatedBy">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#SharedVehicleStation"/>
        <rdfs:range rdf:resource="http://schema.org/Organization"/>
        <rdfs:comment xml:lang="es">Relación entre una estación de vehículos compartidos y la organización que la opera.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relationship between a vehicle-sharing station and the organization that operates it.</rdfs:comment>
        <rdfs:label xml:lang="es">operado por</rdfs:label>
        <rdfs:label xml:lang="en">operated by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#originDock -->

    <owl:ObjectProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#originDock">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#Route"/>
        <rdfs:range rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#Dock"/>
        <rdfs:comment xml:lang="es">El anclaje en una estación desde donde el vehículo salió a una cierta ruta.</rdfs:comment>
        <rdfs:comment xml:lang="en">The dock in a station from where the vehicle departed on a certain route.</rdfs:comment>
        <rdfs:label xml:lang="en">origin dock</rdfs:label>
        <rdfs:label xml:lang="es">tiene anclaje origen</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#originSpot -->

    <owl:ObjectProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#originSpot">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#Route"/>
        <rdfs:range rdf:resource="http://vocab.ciudadesabiertas.es/def/urbanismo-infraestructuras/aparcamiento#ParkingSpot"/>
        <rdfs:comment>Parking spot from where the vehicle route starts.</rdfs:comment>
        <rdfs:comment xml:lang="es">Plaza de aparcamiento desde donde sale la ruta del vehículo.</rdfs:comment>
        <rdfs:label xml:lang="en">origin parking spot</rdfs:label>
        <rdfs:label xml:lang="es">plaza de aparcamiento origen</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#propulsionSystemType -->

    <owl:ObjectProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#propulsionSystemType">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#SharedVehicle"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="http://vocab.linkeddata.es/datosabiertos/kos/edint/PropulsionSystemType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Relación entre un vehículo y un concepto de la taxonomía de tipos de sistema de propulsión como por ejemplo, eléctrico, gasolina, híbrido.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relationship between a vehicle and a concept from the taxonomy of propulsion system types such as electric, gasoline, hybrid.</rdfs:comment>
        <rdfs:label xml:lang="en">propulsion system type</rdfs:label>
        <rdfs:label xml:lang="es">tipo de sistema de propulsión</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#stationState -->

    <owl:ObjectProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#stationState">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#SharedVehicleStation"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="http://vocab.linkeddata.es/datosabiertos/kos/edint/StationState"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Relación entre una Estación y un concepto de la taxonomía de estados de una estación, por ejemplo operativa o no operativa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relationship between a station and a concept of the taxonomy of states of a station, for example operational or non-operational.</rdfs:comment>
        <rdfs:label xml:lang="es">estado de la estación</rdfs:label>
        <rdfs:label xml:lang="en">station state</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#vehicleState -->

    <owl:ObjectProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#vehicleState">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#SharedVehicle"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="http://vocab.linkeddata.es/datosabiertos/kos/edint/VehicleState"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Relación entre un vehículo compartido y un concepto de la taxonomía de posibles estados de un vehículo, por ejemplo activo, en reparación, abandonado.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relationship between a shared vehicle and a concept from the taxonomy of possible vehicle states, for example active, under repair, abandoned.</rdfs:comment>
        <rdfs:label xml:lang="es">estado del vehículo</rdfs:label>
        <rdfs:label xml:lang="en">vehicle state</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#hasGeometry -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#hasGeometry">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <rdfs:comment xml:lang="en">A spatial representation for a given feature.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una representación espacial para una característica determinada.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0"/>
        <rdfs:label xml:lang="en">has geometry</rdfs:label>
        <rdfs:label xml:lang="es">tiene geometría</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2004/02/skos/core#inScheme -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#inScheme">
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
        <rdfs:label xml:lang="es">está en el esquema</rdfs:label>
        <rdfs:label xml:lang="en">is in scheme</rdfs:label>
        <skos:definition xml:lang="en">Relaciona un recurso (por ejemplo un concepto) con un esquema de conceptos en el que está incluido.</skos:definition>
        <skos:definition xml:lang="en">Relates a resource (for example a concept) to a concept scheme in which it is included.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#hasBeginning -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasBeginning">
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:comment xml:lang="en">Beginning of a temporal entity</rdfs:comment>
        <rdfs:comment xml:lang="es">Comienzo de una entidad temporal.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Beginning</rdfs:label>
        <rdfs:label xml:lang="es">Tiene principio</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#hasEnd -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasEnd">
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:comment xml:lang="en">End of a temporal entity</rdfs:comment>
        <rdfs:comment xml:lang="es">Final de una entidad temporal.</rdfs:comment>
        <rdfs:label xml:lang="en">Has End</rdfs:label>
        <rdfs:label xml:lang="es">Tiene final</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/hasFeatureOfInterest -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hasFeatureOfInterest">
        <rdfs:comment xml:lang="en">A relation between an Observation and the entity whose quality was observed.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una relación entre una Observación y la entidad para la que se ha observado.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">has feature of interest</rdfs:label>
        <rdfs:label xml:lang="es">tiene característica de interés</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/hasResult -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hasResult">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/isResultOf"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Result"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
        <rdfs:comment xml:lang="es">Relación que vincula una observación, una actuación o un acto de muestreo con un resultado o una muestra.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relation linking an Observation or Actuation or act of Sampling and a Result or Sample.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
        <rdfs:label xml:lang="en">has result</rdfs:label>
        <rdfs:label xml:lang="es">tiene resultado</rdfs:label>
        <skos:definition xml:lang="en">Relation linking an Observation or Actuation or act of Sampling and a Result or Sample.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/isHostedBy -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/isHostedBy">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:range rdf:resource="http://w3.org/ns/sosa/Platform"/>
        <rdfs:comment xml:lang="en">Relation between a Sensor, or Actuator, Sampler, or Platform, and the Platform that it is mounted on or hosted by.</rdfs:comment>
        <rdfs:label xml:lang="en">is hosted by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/isResultOf -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/isResultOf"/>
    


    <!-- http://www.w3.org/ns/sosa/madeBySensor -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/madeBySensor">
        <rdfs:comment xml:lang="en">Relación entre una Observación y un Sensor que realiza la Observación.</rdfs:comment>
        <rdfs:comment xml:lang="es">Relation between an Observation and the Sensor which made the Observation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">made by sensor</rdfs:label>
        <rdfs:label xml:lang="es">realizada por sensor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/observedProperty -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/observedProperty">
        <rdfs:comment xml:lang="es">Relación que enlaza la propiedad que se observa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relation linking an Observation to the property that was observed. The ObservableProperty should be a property of the FeatureOfInterest (linked by hasFeatureOfInterest) of this Observation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">observed property</rdfs:label>
        <rdfs:label xml:lang="es">propiedad observada</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/observes -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/observes">
        <rdfs:comment xml:lang="es">Relación entre un Sensor y una Propiedad Observada que es capaz de obtener observaciones.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relation between a Sensor and an ObservableProperty that it is capable of sensing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="es">observa</rdfs:label>
        <rdfs:label xml:lang="en">observes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/phenomenonTime -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/phenomenonTime">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdfs:comment xml:lang="es">Esta propiedad establece el intervalo de tiempo de la observación.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property sets the interval of time of the observation</rdfs:comment>
        <rdfs:label xml:lang="es">intervalo de tiempo</rdfs:label>
        <rdfs:label xml:lang="en">time interval</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://schema.org/endDate -->

    <owl:DatatypeProperty rdf:about="http://schema.org/endDate">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="es">La fecha y hora de finalización de
	una incidencia (en formato fecha ISO 8601)</rdfs:comment>
        <rdfs:comment xml:lang="en">The end date and time of an incidence (in ISO 8601 date format).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/"/>
        <rdfs:label xml:lang="en">end date</rdfs:label>
        <rdfs:label xml:lang="es">fecha de fin</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/startDate -->

    <owl:DatatypeProperty rdf:about="http://schema.org/startDate">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="es">La fecha y hora de inicio de una incidencia (en formato fecha ISO 8601).</rdfs:comment>
        <rdfs:comment xml:lang="en">The start date and time of an incidence (in ISO 8601 date format).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/"/>
        <rdfs:label xml:lang="en">(expected) start date</rdfs:label>
        <rdfs:label xml:lang="es">fecha de inicio (prevista)</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#closureDate -->

    <owl:DatatypeProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#closureDate">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#SharedVehicleStation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date when the station ceases operation.</rdfs:comment>
        <rdfs:comment xml:lang="es">Fecha en la cual la estación cesa sus operaciones.</rdfs:comment>
        <rdfs:label xml:lang="en">closure date</rdfs:label>
        <rdfs:label xml:lang="es">fecha de baja</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#comissioningDate -->

    <owl:DatatypeProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#comissioningDate">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#SharedVehicleStation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Date when the station is officially tested, certified, and put into active service.</rdfs:comment>
        <rdfs:comment xml:lang="es">Fecha en que la estación es certificada y puesta en servicio oficialmente.</rdfs:comment>
        <rdfs:label xml:lang="en">comissionning date</rdfs:label>
        <rdfs:label xml:lang="es">fecha de alta</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#order -->

    <owl:DatatypeProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#order">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#Waypoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="es">El número de orden un un punto de paso.</rdfs:comment>
        <rdfs:comment xml:lang="en">The order number of a waypoint.</rdfs:comment>
        <rdfs:label xml:lang="es">orden</rdfs:label>
        <rdfs:label xml:lang="en">order</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#passingDateTime -->

    <owl:DatatypeProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#passingDateTime">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#Waypoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en"></rdfs:comment>
        <rdfs:comment xml:lang="en">Date and time when the vehicle passed through the waypoint in a route.</rdfs:comment>
        <rdfs:comment xml:lang="es">Fecha y hora en que el vehículo pasó por el punto en la ruta.</rdfs:comment>
        <rdfs:label xml:lang="es">fecha y hora punto de paso</rdfs:label>
        <rdfs:label xml:lang="en">passing date and time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#lat -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#lat">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/sf#Point"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="es">Latitud en WGS84</rdfs:comment>
        <rdfs:comment xml:lang="en">Latitude in WGS84</rdfs:comment>
        <rdfs:label>latitude</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#long -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#long">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/sf#Point"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:comment xml:lang="es">Longitud en WGS84</rdfs:comment>
        <rdfs:comment xml:lang="en">Longitude in WGS84</rdfs:comment>
        <rdfs:label>longitude</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/2006/time#inXSDgYearMonth -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2006/time#inXSDgYearMonth">
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYearMonth"/>
        <rdfs:comment xml:lang="es">Posición de un instante, expresado utilizando xsd:gYearMonth.</rdfs:comment>
        <rdfs:comment xml:lang="en">Position of an instant, expressed using xsd:gYearMonth.</rdfs:comment>
        <rdfs:label xml:lang="es">en año-mes gregoriano XSD</rdfs:label>
        <rdfs:label xml:lang="en">in XSD g-YearMonth</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://qudt.org/schema/qudt/Concept -->

    <owl:Class rdf:about="http://qudt.org/schema/qudt/Concept"/>
    


    <!-- http://qudt.org/schema/qudt/Quantifiable -->

    <owl:Class rdf:about="http://qudt.org/schema/qudt/Quantifiable"/>
    


    <!-- http://qudt.org/schema/qudt/QuantityValue -->

    <owl:Class rdf:about="http://qudt.org/schema/qudt/QuantityValue">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Concept"/>
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Quantifiable"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt/hasUnit"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Quantity Value expresses the magnitude and kind of a quantity and is given by the product of a numerical value n and a unit of measure U. The number multiplying the unit is referred to as the numerical value of the quantity expressed in that unit. Refer to &quot;http://physics.nist.gov/Pubs/SP811/sec07.html&quot;, NIST SP 811, section 7 for more on quantity values.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/schema/qudt"/>
        <rdfs:label>Quantity value</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/Unit -->

    <owl:Class rdf:about="http://qudt.org/schema/qudt/Unit">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Concept"/>
    </owl:Class>
    


    <!-- http://schema.org/Organization -->

    <owl:Class rdf:about="http://schema.org/Organization">
        <rdfs:comment xml:lang="es">Representa un conjunto de personas organizadas en una comunidad u otra estructura social, comercial o política.</rdfs:comment>
        <rdfs:comment xml:lang="en">Represents a collection of people organized together into a community or other social, commercial or political structure.</rdfs:comment>
        <rdfs:label xml:lang="es">Organización</rdfs:label>
        <rdfs:label xml:lang="en">Organization</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.ciudadesabiertas.es/def/urbanismo-infraestructuras/aparcamiento#ParkingSpot -->

    <owl:Class rdf:about="http://vocab.ciudadesabiertas.es/def/urbanismo-infraestructuras/aparcamiento#ParkingSpot">
        <rdfs:comment xml:lang="en">Individual parking space on-street or off-street.</rdfs:comment>
        <rdfs:comment xml:lang="es">Plaza individual de estacionamiento dentro o fuera de la vía pública.</rdfs:comment>
        <rdfs:label xml:lang="en">Parking spot</rdfs:label>
        <rdfs:label xml:lang="es">Plaza de aparcamiento</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/censovehiculos#Vehicle -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/censovehiculos#Vehicle">
        <rdfs:comment xml:lang="es">Dispositivo de transporte autopropulsado, junto con cualquier accesorio, por ejemplo remolques, que es un usuario legal de la red de transporte (Fuente: ISO/TS 19091:2019(en)).</rdfs:comment>
        <rdfs:comment xml:lang="en">Self-propelled transport device, along with any attachments, e.g. trailers, that is a legal user of the transportation network (Source: ISO/TS 19091:2019(en)).</rdfs:comment>
        <rdfs:label xml:lang="en">Vehicle</rdfs:label>
        <rdfs:label xml:lang="es">Vehículo</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#Dock -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#Dock">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:comment xml:lang="es">Lugar de la estación donde se fijan las bicicletas</rdfs:comment>
        <rdfs:comment xml:lang="en">Place in the station where the vehicles are secured.</rdfs:comment>
        <rdfs:label xml:lang="es">Anclaje</rdfs:label>
        <rdfs:label xml:lang="en">Dock</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#DockObservation -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#DockObservation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:comment xml:lang="es">Observación mediante un sensor de anclaje que detecta su disponibilidad para aparcar un vehículo (libre) o si está ocupado por un vehículo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Observation by a dock sensor that detects the dock&apos;s availability to park a vehicle (free), or occupied by a vehicle.</rdfs:comment>
        <rdfs:label xml:lang="en">Dock observation</rdfs:label>
        <rdfs:label xml:lang="es">Observación de anclaje</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#DockProperty -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#DockProperty">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <rdfs:comment xml:lang="es">Observable properties of the dock that refer to its availability: free or occupied by a vehicle.</rdfs:comment>
        <rdfs:comment xml:lang="es">Propiedades que están relacionadas con la disponibilidad de los anclajes (vacíos u ocupados) en donde se enganchan los vehículos.</rdfs:comment>
        <rdfs:label xml:lang="en">Dock property</rdfs:label>
        <rdfs:label xml:lang="es">Propiedad de anclaje</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#DockSensor -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#DockSensor">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:comment xml:lang="en">Equipment that allows you to detect if an anchor is free or occupied.</rdfs:comment>
        <rdfs:label xml:lang="en">Dock sensor</rdfs:label>
        <rdfs:label xml:lang="es">Equipo que permite detectar si un anclaje está libre u ocupado.</rdfs:label>
        <rdfs:label xml:lang="es">Sensor de anclaje</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#Route -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#Route">
        <rdfs:comment xml:lang="es">Espacio que se recorre para llegar desde un origen hasta un destino.</rdfs:comment>
        <rdfs:comment xml:lang="en">The path traveled to get from an origin to a destination</rdfs:comment>
        <rdfs:label xml:lang="en">Route</rdfs:label>
        <rdfs:label xml:lang="es">Trayecto</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#SharedVehicle -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#SharedVehicle">
        <rdfs:subClassOf rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/censovehiculos#Vehicle"/>
        <rdfs:comment xml:lang="es">Medio de transporte —como un coche, una bicicleta o un patinete eléctrico— que permite a varios usuarios acceder a él a corto plazo y bajo demanda.</rdfs:comment>
        <rdfs:comment xml:lang="en">Transport mode—such as a car, bike, or e-scooter—that allows multiple users to gain short-term, on-demand access.</rdfs:comment>
        <rdfs:label xml:lang="en">Shared vehicle</rdfs:label>
        <rdfs:label xml:lang="es">Vehículo compartido</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#SharedVehicleStation -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#SharedVehicleStation">
        <rdfs:subClassOf rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#Facility"/>
        <rdfs:subClassOf rdf:resource="http://w3.org/ns/sosa/Platform"/>
        <rdfs:comment xml:lang="es">Lugar donde se puede tanto dejar como recoger los vehículos compartidos. Está compuesto de anclajes.</rdfs:comment>
        <rdfs:comment xml:lang="en">Place where you can both leave and pick up a shared vehicles. It is composed of docks</rdfs:comment>
        <rdfs:label xml:lang="es">Estación de vehículos compartidos</rdfs:label>
        <rdfs:label xml:lang="en">Shared vehicle station</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#Waypoint -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#Waypoint">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="en">Part of a route defined by coordinates and a date and time</rdfs:comment>
        <rdfs:comment xml:lang="es">Parte de un trayecto definido por unas coordenadas y una fecha y hora.</rdfs:comment>
        <rdfs:label xml:lang="es">Punto de paso</rdfs:label>
        <rdfs:label xml:lang="en">Waypoint</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#Facility -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#Facility">
        <rdfs:subClassOf rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#InfrastructureElement"/>
        <rdfs:comment xml:lang="es">Hace referencia a edificios de servicios (públicos o privados), zonas de ocio, zonas comerciales o cualquier otro elemento  que afecte directamente a la movilidad, actuando como un foco de atracción de personas o vehículos.</rdfs:comment>
        <rdfs:comment xml:lang="en">It refers to service buildings (public or private), leisure areas, commercial areas or any other element that directly affects mobility, acting as a focus of attraction for persons or vehicles.</rdfs:comment>
        <rdfs:label xml:lang="es">Equipamiento</rdfs:label>
        <rdfs:label xml:lang="en">Facility</rdfs:label>
    </owl:Class>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#InfrastructureElement -->

    <owl:Class rdf:about="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/infraestructura#InfrastructureElement">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="es">Representa el conjunto de todos los elementos de la infraestructura que generan movilidad y elementos urbanos tales como semáforos, señales viales, pilonas, etc.</rdfs:comment>
        <rdfs:comment xml:lang="en">Represents the set of all infrastructure elements that generate mobility and urban elements such as traffic lights, road signs, bollards, etc.</rdfs:comment>
        <rdfs:label xml:lang="es">Elemento de la infraestructura</rdfs:label>
        <rdfs:label xml:lang="en">Infrastructure element</rdfs:label>
    </owl:Class>
    


    <!-- http://w3.org/ns/sosa/Platform -->

    <owl:Class rdf:about="http://w3.org/ns/sosa/Platform">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="en">A Platform is an entity that hosts other entities, particularly Sensors, Actuators, Samplers, and other Platforms.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una plataforma es una entidad que alberga otras entidades, en particular sensores, actuadores, muestreadores y otras plataformas.</rdfs:comment>
        <rdfs:label xml:lang="es">Plataforma</rdfs:label>
        <rdfs:label xml:lang="en">Platform</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opengis.net/ont/geosparql#Feature -->

    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Feature">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:comment xml:lang="en">Esta clase representa una característica de alto nivel, equivalente a GFI_Feature definida en ISP 19156 y es una supercale para todos los tipos de características espaciales.</rdfs:comment>
        <rdfs:comment xml:lang="en">This class represents the top-level feature type. This
	class is equivalent to GFI_Feature defined in ISO 19156, and it is superclass of
	all feature types.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
        <rdfs:label xml:lang="es">Característica geográfica</rdfs:label>
        <rdfs:label xml:lang="en">Feature</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opengis.net/ont/geosparql#Geometry -->

    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Geometry">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
        <rdfs:comment xml:lang="es">Esta clase representa el tipo de geometría de alto nivel. Es equivalente a GFI_Geometry definida en ISO 19156 y es superclase de todos los tipos geométricos.</rdfs:comment>
        <rdfs:comment xml:lang="en">This class represents the top-level geometry type. This class is equivalent to GFI_Geometry defined in ISO 19156, and it is superclass of all geometry types.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
        <rdfs:label xml:lang="en">Geometry</rdfs:label>
        <rdfs:label xml:lang="es">Geometría</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opengis.net/ont/geosparql#SpatialObject -->

    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#SpatialObject">
        <rdfs:comment xml:lang="es">Esta clase representa un tipo de objeto espacial de alto nivel. Es equivalente a GFI SpatialObject difinido en ISO 19156 y es una superclase de todos los tipos de objetos espaciales.</rdfs:comment>
        <rdfs:comment xml:lang="en">This class represents the top-level spatial object
	type. This class is equivalent to GFI_SpatialObject defined in ISO 19156, and it
	is superclass of all spatial object types.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
        <rdfs:label xml:lang="es">Objeto Espacial</rdfs:label>
        <rdfs:label xml:lang="en">SpatialObject</rdfs:label>
    </owl:Class>
    


    <!-- http://www.opengis.net/ont/sf#Point -->

    <owl:Class rdf:about="http://www.opengis.net/ont/sf#Point">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <rdfs:comment xml:lang="es">Se representa un tipo de punto de alto nivel. Esta clase es equivalente a GFI_Point definida en ISO 19156 y es superclase de todos los tipos de puntos.</rdfs:comment>
        <rdfs:comment xml:lang="en">This class represents the top-level point type. This 	class is equivalent to GFI_Point defined in ISO 19156, and it is superclass of all point types.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
        <rdfs:label xml:lang="en">Geographic Point</rdfs:label>
        <rdfs:label xml:lang="es">Punto geográfico</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2004/02/skos/core#Concept -->

    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept">
        <owl:disjointWith rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <dct:issued>2004-02-xx</dct:issued>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
        <rdfs:label xml:lang="en">Concept</rdfs:label>
        <rdfs:label xml:lang="es">Concepto</rdfs:label>
        <skos:definition xml:lang="en">An abstract idea or notion; a unit of thought.</skos:definition>
        <skos:definition xml:lang="es">Una idea o noción abstracta; una unidad de pensamiento.</skos:definition>
    </owl:Class>
    


    <!-- http://www.w3.org/2004/02/skos/core#ConceptScheme -->

    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#ConceptScheme">
        <rdfs:comment xml:lang="en">A concept scheme may be defined to include concepts from different sources.</rdfs:comment>
        <rdfs:comment xml:lang="en">Thesauri, classification schemes, subject heading lists, taxonomies, &apos;folksonomies&apos;, and other types of controlled vocabulary are all examples of concept schemes.  Concept schemes are also embedded in glossaries and terminologies.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
        <rdfs:label xml:lang="en">Concept Scheme</rdfs:label>
        <rdfs:label xml:lang="es">Esquema de conceptos</rdfs:label>
        <skos:definition xml:lang="en">A set of concepts, optionally including statements about semantic relationships between those concepts.</skos:definition>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#Instant -->

    <owl:Class rdf:about="http://www.w3.org/2006/time#Instant">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:comment xml:lang="en">A temporal entity with zero extent or duration.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una entidad temporal con extensión o duración de cero.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time#"/>
        <rdfs:label xml:lang="es">Instante de tiempo</rdfs:label>
        <rdfs:label xml:lang="en">Time instant</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#Interval -->

    <owl:Class rdf:about="http://www.w3.org/2006/time#Interval">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:comment xml:lang="en">A temporal entity with an extent or duration.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una entidad temporal con extensión o duración</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time#"/>
        <rdfs:label xml:lang="en">Time interval</rdfs:label>
        <rdfs:label xml:lang="es">intervalo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#ProperInterval -->

    <owl:Class rdf:about="http://www.w3.org/2006/time#ProperInterval">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#Interval"/>
        <rdfs:comment xml:lang="en">A temporal entity with non-zero extent or duration, i.e. for which the value of the beginning and end are different.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una entidad temporal con extensión o duración distinta de cero, es decir, para la cual los valores de principio y fin del intervalo son diferentes</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time#"/>
        <rdfs:label xml:lang="en">Proper interval</rdfs:label>
        <rdfs:label xml:lang="es">intervalo preciso</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#TemporalEntity -->

    <owl:Class rdf:about="http://www.w3.org/2006/time#TemporalEntity">
        <rdfs:comment xml:lang="en">A temporal interval or instant.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un intervalo temporal o un instante.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2006/time#"/>
        <rdfs:label xml:lang="es">Entidad temporal</rdfs:label>
        <rdfs:label xml:lang="en">Temporal Entity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/sosa/FeatureOfInterest -->

    <owl:Class rdf:about="http://www.w3.org/ns/sosa/FeatureOfInterest">
        <rdfs:comment xml:lang="en">The thing whose property is being estimated or calculated in the course of an Observation to arrive at a Result or whose property is being manipulated by an Actuator, or which is being sampled or transformed in an act of Sampling.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">Feature Of Interest</rdfs:label>
        <skos:definition xml:lang="en">The thing whose property is being estimated or calculated in the course of an Observation to arrive at a Result or whose property is being manipulated by an Actuator, or which is being sampled or transformed in an act of Sampling.</skos:definition>
        <skos:example xml:lang="en">When measuring the height of a tree, the height is the observed ObservableProperty, 20m may be the Result of the Observation, and the tree is the FeatureOfInterest. A window is a FeatureOfInterest for an automatic window control Actuator.</skos:example>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/sosa/ObservableProperty -->

    <owl:Class rdf:about="http://www.w3.org/ns/sosa/ObservableProperty">
        <rdfs:comment xml:lang="en">An observable quality (property, characteristic) of a FeatureOfInterest.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">Observable Property</rdfs:label>
        <skos:definition xml:lang="en">An observable quality (property, characteristic) of a FeatureOfInterest.</skos:definition>
        <skos:example xml:lang="en">The height of a tree, the depth of a water body, or the temperature of a surface are examples of observable properties, while the value of a classic car is not (directly) observable but asserted.</skos:example>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/sosa/Observation -->

    <owl:Class rdf:about="http://www.w3.org/ns/sosa/Observation">
        <rdfs:comment xml:lang="en">Act of carrying out an (Observation) Procedure to estimate or calculate a value of a property of a FeatureOfInterest. Links to a Sensor to describe what made the Observation and how; links to an ObservableProperty to describe what the result is an estimate of, and to a FeatureOfInterest to detail what that property was associated with</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">Observation</rdfs:label>
        <skos:definition xml:lang="en">Act of carrying out an (Observation) Procedure to estimate or calculate a value of a property of a FeatureOfInterest. Links to a Sensor to describe what made the Observation and how; links to an ObservableProperty to describe what the result is an estimate of, and to a FeatureOfInterest to detail what that property was associated with.</skos:definition>
        <skos:example xml:lang="en">The activity of estimating the intensity of an Earthquake using the Mercalli intensity scale is an Observation as is measuring the moment magnitude, i.e., the energy released by said earthquake.</skos:example>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/sosa/Sensor -->

    <owl:Class rdf:about="http://www.w3.org/ns/sosa/Sensor">
        <rdfs:comment xml:lang="en">Device, agent (including humans), or software (simulation) involved in, or implementing, a Procedure. Sensors respond to a stimulus, e.g., a change in the environment, or input data composed from the results of prior Observations, and generate a Result. Sensors can be hosted by Platforms.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:label xml:lang="en">Sensor</rdfs:label>
        <skos:definition xml:lang="en">Device, agent (including humans), or software (simulation) involved in, or implementing, a Procedure. Sensors respond to a stimulus, e.g., a change in the environment, or input data composed from the results of prior Observations, and generate a Result. Sensors can be hosted by Platforms.</skos:definition>
        <skos:example xml:lang="en">Accelerometers, gyroscopes, barometers, magnetometers, and so forth are Sensors that are typically mounted on a modern smart phone (which acts as Platform). Other examples of sensors include the human eyes.</skos:example>
    </owl:Class>
    


