<?xml version="1.0"?>
<rdf:RDF xmlns="http://vocab.ciudadesabiertas.es/def/transporte/vehiculos-compartidos#"
     xml:base="http://vocab.ciudadesabiertas.es/def/transporte/vehiculos-compartidos"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:p0="http://vocab.ciudadesabiertas.es/def/transporte/censovehiculos#"
     xmlns:sf="http://www.opengis.net/ont/sf#"
     xmlns:dct="http://purl.org/dc/terms/"
     xmlns:geo="http://www.w3.org/2003/01/geo/wgs84_pos#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:qudt="http://qudt.org/schema/qudt/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:sosa="http://w3.org/ns/sosa/"
     xmlns:time="http://www.w3.org/2006/time#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:escjr="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/callejero#"
     xmlns:schema="http://schema.org/"
     xmlns:geocore="https://datos.ign.es/def/geo_core#"
     xmlns:edintinf="http://vocab.ciudadesabiertas.es/def/urbanismo-infraestructuras/infraestrucura#"
     xmlns:edintkos="http://vocab.linkeddata.es/datosabiertos/kos/edint/"
     xmlns:edintveh="http://vocab.linkeddata.es/datosabiertos/def/transporte/censovehiculos#"
     xmlns:edintapar="http://vocab.ciudadesabiertas.es/def/urbanismo-infraestructuras/aparcamiento#"
     xmlns:geosparql="http://www.opengis.net/ont/geosparql#"
     xmlns:edintvehcom="http://vocab.ciudadesabiertas.es/def/transporte/vehiculos-compartidos#">
    <owl:Ontology rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos">
        <owl:versionIRI rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos/0.1.0"/>
        <dc:creator>Daniel Doña</dc:creator>
        <dc:creator>Edna Ruckhaus</dc:creator>
        <dc:creator>Lucía Sánchez</dc:creator>
        <dc:creator>Oscar Corcho</dc:creator>
        <dc:creator>Socorro Bernardos</dc:creator>
        <dc:title xml:lang="es">Vocabulario para la representación de datos sobre sistemas de vehiculos compartidos en las ciudades</dc:title>
        <dc:title xml:lang="en">Vocabulary for the representation of data on shared vehicle systems in cities</dc:title>
        <dct:created>2026-05-18</dct:created>
        <dct:license rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://creativecommons.org/licenses/by/4.0</dct:license>
        <vann:preferredNamespacePrefix>edintvehcom</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#"/>
        <rdfs:comment xml:lang="es">La ontología de Vehículos Compartidos representa los datos de sistemas de vehículos compartidos. Los modelos de sistemas representados incluyen: (1)  Basados en estaciones con sensores en sus anclajes y (2) Libres, es decir aquellos sistemas que permiten que el vehículo se encuentre en algún lugar de aparcamiento permitido y que son ubicados a través de sus datos geoespaciales. 
Además, se representan datos de los trayectos realizados por estos vehículos incluyendo lu punto de origen y de destino.</rdfs:comment>
        <rdfs:comment xml:lang="en">The Shared Vehicles ontology represents data from shared vehicle systems. The system models represented include: (1) Station-based systems with sensors at their docking points and (2) Free-floating systems, that is, those systems that allow the vehicle to be located in a permitted parking spot and are identified through their geospatial data.
In addition, data on the journeys made by these vehicles, including their origin and destination points, are represented.</rdfs:comment>
        <owl:versionInfo>0.1.0</owl:versionInfo>
    </owl:Ontology>
    


