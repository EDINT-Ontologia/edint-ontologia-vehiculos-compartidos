        <rdfs:label xml:lang="es">disponibilidad del anclaje</rdfs:label>
        <rdfs:label xml:lang="en">dock availability</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#numberEmptyDocks -->

    <owl:NamedIndividual rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#numberEmptyDocks">
        <rdf:type rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#DockProperty"/>
        <rdfs:comment xml:lang="es">Número total de anclajes vacíos en la estación, es decir, disponibles para aparcar un vehículo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Total number of empty docks at the station, i.e., available to park a vehicle.</rdfs:comment>
        <rdfs:label xml:lang="en">number of empty docks</rdfs:label>
        <rdfs:label xml:lang="es">número de anclajes vacíos</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#numberOccupiedDocks -->

    <owl:NamedIndividual rdf:about="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#numberOccupiedDocks">
        <rdf:type rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#DockProperty"/>
        <rdfs:comment xml:lang="es">Número total de anclajes ocupados por vehículos.</rdfs:comment>
        <rdfs:comment xml:lang="en">Total number of docks that are occupied by vehicles.</rdfs:comment>
        <rdfs:label xml:lang="en">number occupied docks</rdfs:label>
        <rdfs:label xml:lang="es">número de anclajes ocupados</rdfs:label>
    </owl:NamedIndividual>
    


