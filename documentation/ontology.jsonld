  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Latitud en WGS84"
  }, {
    "@language" : "en",
    "@value" : "Latitude in WGS84"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.opengis.net/ont/sf#Point"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "latitude"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#float"
  } ]
}, {
  "@id" : "http://www.w3.org/2003/01/geo/wgs84_pos#long",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Longitud en WGS84"
  }, {
    "@language" : "en",
    "@value" : "Longitude in WGS84"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.opengis.net/ont/sf#Point"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "longitude"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#float"
  } ]
}, {
  "@id" : "http://www.w3.org/2004/02/skos/core#Concept",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.org/dc/terms/issued" : [ {
    "@value" : "2004-02-xx"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Concept"
  }, {
    "@language" : "es",
    "@value" : "Concepto"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An abstract idea or notion; a unit of thought."
  }, {
    "@language" : "es",
    "@value" : "Una idea o noción abstracta; una unidad de pensamiento."
  } ]
}, {
  "@id" : "http://www.w3.org/2004/02/skos/core#ConceptScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A concept scheme may be defined to include concepts from different sources."
  }, {
    "@language" : "en",
    "@value" : "Thesauri, classification schemes, subject heading lists, taxonomies, 'folksonomies', and other types of controlled vocabulary are all examples of concept schemes.  Concept schemes are also embedded in glossaries and terminologies."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Concept Scheme"
  }, {
    "@language" : "es",
    "@value" : "Esquema de conceptos"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A set of concepts, optionally including statements about semantic relationships between those concepts."
  } ]
}, {
  "@id" : "http://www.w3.org/2004/02/skos/core#definition",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "http://www.w3.org/2004/02/skos/core#example",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ]
}, {
  "@id" : "http://www.w3.org/2004/02/skos/core#inScheme",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "está en el esquema"
  }, {
    "@language" : "en",
    "@value" : "is in scheme"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#ConceptScheme"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Relaciona un recurso (por ejemplo un concepto) con un esquema de conceptos en el que está incluido."
  }, {
    "@language" : "en",
    "@value" : "Relates a resource (for example a concept) to a concept scheme in which it is included."
  } ]
}, {
  "@id" : "http://www.w3.org/2006/time#Instant",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A temporal entity with zero extent or duration."
  }, {
    "@language" : "es",
    "@value" : "Una entidad temporal con extensión o duración de cero."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/2006/time#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Instante de tiempo"
  }, {
    "@language" : "en",
    "@value" : "Time instant"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2006/time#TemporalEntity"
  } ]
}, {
  "@id" : "http://www.w3.org/2006/time#Interval",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A temporal entity with an extent or duration."
  }, {
    "@language" : "es",
    "@value" : "Una entidad temporal con extensión o duración"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/2006/time#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Time interval"
  }, {
    "@language" : "es",
    "@value" : "intervalo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2006/time#TemporalEntity"
  } ]
}, {
  "@id" : "http://www.w3.org/2006/time#ProperInterval",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A temporal entity with non-zero extent or duration, i.e. for which the value of the beginning and end are different."
  }, {
    "@language" : "es",
    "@value" : "Una entidad temporal con extensión o duración distinta de cero, es decir, para la cual los valores de principio y fin del intervalo son diferentes"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/2006/time#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Proper interval"
  }, {
    "@language" : "es",
    "@value" : "intervalo preciso"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2006/time#Interval"
  } ]
}, {
  "@id" : "http://www.w3.org/2006/time#TemporalEntity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A temporal interval or instant."
  }, {
    "@language" : "es",
    "@value" : "Un intervalo temporal o un instante."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/2006/time#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Entidad temporal"
  }, {
    "@language" : "en",
    "@value" : "Temporal Entity"
  } ]
}, {
  "@id" : "http://www.w3.org/2006/time#hasBeginning",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Beginning of a temporal entity"
  }, {
    "@language" : "es",
    "@value" : "Comienzo de una entidad temporal."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3.org/2006/time#ProperInterval"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Has Beginning"
  }, {
    "@language" : "es",
    "@value" : "Tiene principio"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2006/time#Instant"
  } ]
}, {
  "@id" : "http://www.w3.org/2006/time#hasEnd",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "End of a temporal entity"
  }, {
    "@language" : "es",
    "@value" : "Final de una entidad temporal."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3.org/2006/time#ProperInterval"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Has End"
  }, {
    "@language" : "es",
    "@value" : "Tiene final"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2006/time#Instant"
  } ]
}, {
  "@id" : "http://www.w3.org/2006/time#inXSDgYearMonth",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Posición de un instante, expresado utilizando xsd:gYearMonth."
  }, {
    "@language" : "en",
    "@value" : "Position of an instant, expressed using xsd:gYearMonth."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3.org/2006/time#Instant"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "en año-mes gregoriano XSD"
  }, {
    "@language" : "en",
    "@value" : "in XSD g-YearMonth"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#gYearMonth"
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/FeatureOfInterest",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The thing whose property is being estimated or calculated in the course of an Observation to arrive at a Result or whose property is being manipulated by an Actuator, or which is being sampled or transformed in an act of Sampling."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/sosa/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Feature Of Interest"
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "When measuring the height of a tree, the height is the observed ObservableProperty, 20m may be the Result of the Observation, and the tree is the FeatureOfInterest. A window is a FeatureOfInterest for an automatic window control Actuator."
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/ObservableProperty",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An observable quality (property, characteristic) of a FeatureOfInterest."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/sosa/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Observable Property"
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "The height of a tree, the depth of a water body, or the temperature of a surface are examples of observable properties, while the value of a classic car is not (directly) observable but asserted."
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/Observation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Act of carrying out an (Observation) Procedure to estimate or calculate a value of a property of a FeatureOfInterest. Links to a Sensor to describe what made the Observation and how; links to an ObservableProperty to describe what the result is an estimate of, and to a FeatureOfInterest to detail what that property was associated with"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/sosa/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Observation"
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "The activity of estimating the intensity of an Earthquake using the Mercalli intensity scale is an Observation as is measuring the moment magnitude, i.e., the energy released by said earthquake."
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/Sensor",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Device, agent (including humans), or software (simulation) involved in, or implementing, a Procedure. Sensors respond to a stimulus, e.g., a change in the environment, or input data composed from the results of prior Observations, and generate a Result. Sensors can be hosted by Platforms."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/sosa/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Sensor"
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "Accelerometers, gyroscopes, barometers, magnetometers, and so forth are Sensors that are typically mounted on a modern smart phone (which acts as Platform). Other examples of sensors include the human eyes."
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/hasFeatureOfInterest",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A relation between an Observation and the entity whose quality was observed."
  }, {
    "@language" : "es",
    "@value" : "Una relación entre una Observación y la entidad para la que se ha observado."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/sosa/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has feature of interest"
  }, {
    "@language" : "es",
    "@value" : "tiene característica de interés"
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/hasResult",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://schema.org/domainIncludes" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Actuation"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/ObservationCollection"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/Sampling"
  } ],
  "http://schema.org/rangeIncludes" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Result"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/Sample"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Relación que vincula una observación, una actuación o un acto de muestreo con un resultado o una muestra."
  }, {
    "@language" : "en",
    "@value" : "Relation linking an Observation or Actuation or act of Sampling and a Result or Sample."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/sosa/"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/common/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has result"
  }, {
    "@language" : "es",
    "@value" : "tiene resultado"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/isResultOf"
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/isHostedBy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Relation between a Sensor, or Actuator, Sampler, or Platform, and the Platform that it is mounted on or hosted by."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Sensor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is hosted by"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://w3.org/ns/sosa/Platform"
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/isResultOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/madeBySensor",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Relación entre una Observación y un Sensor que realiza la Observación."
  }, {
    "@language" : "es",
    "@value" : "Relation between an Observation and the Sensor which made the Observation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/sosa/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "made by sensor"
  }, {
    "@language" : "es",
    "@value" : "realizada por sensor"
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/observedProperty",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Relación que enlaza la propiedad que se observa."
  }, {
    "@language" : "en",
    "@value" : "Relation linking an Observation to the property that was observed. The ObservableProperty should be a property of the FeatureOfInterest (linked by hasFeatureOfInterest) of this Observation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/sosa/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "observed property"
  }, {
    "@language" : "es",
    "@value" : "propiedad observada"
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/observes",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Relación entre un Sensor y una Propiedad Observada que es capaz de obtener observaciones."
  }, {
    "@language" : "en",
    "@value" : "Relation between a Sensor and an ObservableProperty that it is capable of sensing."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/sosa/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "observa"
  }, {
    "@language" : "en",
    "@value" : "observes"
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/phenomenonTime",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Esta propiedad establece el intervalo de tiempo de la observación."
  }, {
    "@language" : "en",
    "@value" : "This property sets the interval of time of the observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "intervalo de tiempo"
  }, {
    "@language" : "en",
    "@value" : "time interval"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2006/time#ProperInterval"
  } ]
}, {
  "@id" : "https://edint.es/def/aparcamiento#ParkingSpot",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Individual parking space on-street or off-street."
  }, {
    "@language" : "es",
    "@value" : "Plaza individual de estacionamiento dentro o fuera de la vía pública."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Parking spot"
  }, {
    "@language" : "es",
    "@value" : "Plaza de aparcamiento"
  } ]
}, {
  "@id" : "https://edint.es/def/censovehiculos#Vehicle",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Dispositivo de transporte autopropulsado, junto con cualquier accesorio, por ejemplo remolques, que es un usuario legal de la red de transporte (Fuente: ISO/TS 19091:2019(en))."
  }, {
    "@language" : "en",
    "@value" : "Self-propelled transport device, along with any attachments, e.g. trailers, that is a legal user of the transportation network (Source: ISO/TS 19091:2019(en))."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Vehicle"
  }, {
    "@language" : "es",
    "@value" : "Vehículo"
  } ]
}, {
  "@id" : "https://edint.es/def/censovehiculos#vehicleType",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Tipo de vehículo. Los valores son conceptos SKOS que pertenecen a una lista controlada de tipos de vehículos (por ejemplo, bicicleta, patinete, turismo, furgoneta, caravana, etc.)."
  }, {
    "@language" : "en",
    "@value" : "Type of vehicle. The range is a SKOS concept that belongs to a controlled list of vehicle types (e.g., bicycle, scooter, van, truck, caravan, etc.)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "tipo de vehículo"
  }, {
    "@language" : "en",
    "@value" : "vehicle type"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid1"
  } ]
}, {
  "@id" : "https://edint.es/def/infraestructura#Facility",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Hace referencia a edificios de servicios (públicos o privados), zonas de ocio, zonas comerciales o cualquier otro elemento  que afecte directamente a la movilidad, actuando como un foco de atracción de personas o vehículos."
  }, {
    "@language" : "en",
    "@value" : "It refers to service buildings (public or private), leisure areas, commercial areas or any other element that directly affects mobility, acting as a focus of attraction for persons or vehicles."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Equipamiento"
  }, {
    "@language" : "en",
    "@value" : "Facility"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://edint.es/def/infraestructura#InfrastructureElement"
  } ]
}, {
  "@id" : "https://edint.es/def/infraestructura#InfrastructureElement",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Representa el conjunto de todos los elementos de la infraestructura que generan movilidad y elementos urbanos tales como semáforos, señales viales, pilonas, etc."
  }, {
    "@language" : "en",
    "@value" : "Represents the set of all infrastructure elements that generate mobility and urban elements such as traffic lights, road signs, bollards, etc."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Elemento de la infraestructura"
  }, {
    "@language" : "en",
    "@value" : "Infrastructure element"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.opengis.net/ont/geosparql#Feature"
  } ]
}, {
  "@id" : "https://edint.es/def/infraestructura#StationProperty",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Observable properties of the station that refer to the number of occupied docks and the number of empty docks available to park a vehicle."
  }, {
    "@language" : "es",
    "@value" : "Propiedades observables de una estación que se refieren al número de anclajes ocupados o al número de anclajes vacíos disponibles para aparcar un vehiculo."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Propiedad de estación"
  }, {
    "@language" : "en",
    "@value" : "Station property"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/ObservableProperty"
  } ]
}, {
  "@id" : "https://edint.es/def/vehiculos-compartidos",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/created" : [ {
    "@value" : "2026-05-18"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "Daniel Doña"
  }, {
    "@value" : "Edna Ruckhaus"
  }, {
    "@value" : "Lucía Sánchez"
  }, {
    "@value" : "Socorro Bernardos"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "es",
    "@value" : "La ontología de Vehículos Compartidos representa los datos de sistemas de vehículos compartidos. Los modelos de sistemas representados incluyen: (1) Basados en estaciones con sensores en sus anclajes y (2) Libres, es decir aquellos sistemas que permiten que el vehículo se encuentre en algún lugar de aparcamiento permitido y que son ubicados a través de sus datos geoespaciales. Además, se representan datos de los trayectos realizados por estos vehículos incluyendo el punto de origen y de destino."
  }, {
    "@language" : "en",
    "@value" : "The Shared Vehicles ontology represents data from shared vehicle systems. The system models represented include: (1) Station-based systems with sensors at their docking points and (2) Free-floating systems, that is, those systems that allow the vehicle to be located in a permitted parking spot and are identified through their geospatial data. In addition, data on the journeys made by these vehicles, including their origin and destination points, are represented."
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-05-18"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "es",
    "@value" : "Vocabulario para la representación de datos sobre sistemas de vehiculos compartidos en las ciudades"
  }, {
    "@language" : "en",
    "@value" : "Vocabulary for the representation of data on shared vehicle systems in cities"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "edintvehcom"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@id" : "https://edint.es/def/vehiculos-compartidos#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "La ontología de Vehículos Compartidos representa los datos de sistemas de vehículos compartidos. Los modelos de sistemas representados incluyen: (1)  Basados en estaciones con sensores en sus anclajes y (2) Libres, es decir aquellos sistemas que permiten que el vehículo se encuentre en algún lugar de aparcamiento permitido y que son ubicados a través de sus datos geoespaciales. \nAdemás, se representan datos de los trayectos realizados por estos vehículos incluyendo lu punto de origen y de destino."
  }, {
    "@language" : "en",
    "@value" : "The Shared Vehicles ontology represents data from shared vehicle systems. The system models represented include: (1) Station-based systems with sensors at their docking points and (2) Free-floating systems, that is, those systems that allow the vehicle to be located in a permitted parking spot and are identified through their geospatial data.\nIn addition, data on the journeys made by these vehicles, including their origin and destination points, are represented."
  } ],
  "http://www.w3.org/2002/07/owl#priorVersion" : [ {
    "@id" : "https://github.com/EDINT-Ontologia/edint-ontologia-vehiculos-compartidos/releases/tag/v0.1.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://edint.es/def/vehiculos-compartidos"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "0.1.1"
  } ]
}, {
  "@id" : "https://edint.es/def/vehiculos-compartidos#Dock",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Lugar de la estación donde se fijan las bicicletas"
  }, {
    "@language" : "en",
    "@value" : "Place in the station where the vehicles are secured."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Anclaje"
  }, {
    "@language" : "en",
    "@value" : "Dock"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/FeatureOfInterest"
  } ]
}, {
  "@id" : "https://edint.es/def/vehiculos-compartidos#DockObservation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Observación mediante un sensor de anclaje que detecta su disponibilidad para aparcar un vehículo (libre) o si está ocupado por un vehículo."
  }, {
    "@language" : "en",
    "@value" : "Observation by a dock sensor that detects the dock's availability to park a vehicle (free), or occupied by a vehicle."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Dock observation"
  }, {
    "@language" : "es",
    "@value" : "Observación de anclaje"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  } ]
}, {
  "@id" : "https://edint.es/def/vehiculos-compartidos#DockProperty",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Observable property of the dock that refer to its availability: free or occupied by a vehicle."
  }, {
    "@language" : "es",
    "@value" : "Propiedad observable de un anclaje que se refiere a la disponibilidad del anclaje, libre u ocupado por un vehículo."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Dock property"
  }, {
    "@language" : "es",
    "@value" : "Propiedad de anclaje"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/ObservableProperty"
  } ]
}, {
  "@id" : "https://edint.es/def/vehiculos-compartidos#DockSensor",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Equipment that allows you to detect if an anchor is free or occupied."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Dock sensor"
  }, {
    "@language" : "es",
    "@value" : "Equipo que permite detectar si un anclaje está libre u ocupado."
  }, {
    "@language" : "es",
    "@value" : "Sensor de anclaje"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Sensor"
  } ]
}, {
  "@id" : "https://edint.es/def/vehiculos-compartidos#Route",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Espacio que se recorre para llegar desde un origen hasta un destino."
  }, {
    "@language" : "en",
    "@value" : "The path traveled to get from an origin to a destination"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Route"
  }, {
    "@language" : "es",
    "@value" : "Trayecto"
  } ]
}, {
  "@id" : "https://edint.es/def/vehiculos-compartidos#SharedVehicle",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Medio de transporte —como un coche, una bicicleta o un patinete eléctrico— que permite a varios usuarios acceder a él a corto plazo y bajo demanda."
  }, {
    "@language" : "en",
    "@value" : "Transport mode—such as a car, bike, or e-scooter—that allows multiple users to gain short-term, on-demand access."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Shared vehicle"
  }, {
    "@language" : "es",
    "@value" : "Vehículo compartido"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://edint.es/def/censovehiculos#Vehicle"
  } ]
}, {
  "@id" : "https://edint.es/def/vehiculos-compartidos#SharedVehicleStation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Lugar donde se puede tanto dejar como recoger los vehículos compartidos. Está compuesto de anclajes."
  }, {
    "@language" : "en",
    "@value" : "Place where you can both leave and pick up a shared vehicles. It is composed of docks"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Estación de vehículos compartidos"
  }, {
    "@language" : "en",
    "@value" : "Shared vehicle station"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://w3.org/ns/sosa/Platform"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/FeatureOfInterest"
  }, {
    "@id" : "https://edint.es/def/infraestructura#Facility"
  } ]
}, {
  "@id" : "https://edint.es/def/vehiculos-compartidos#Waypoint",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Part of a route defined by coordinates and a date and time"
  }, {
    "@language" : "es",
    "@value" : "Parte de un trayecto definido por unas coordenadas y una fecha y hora."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "es",
    "@value" : "Punto de paso"
  }, {
    "@language" : "en",
    "@value" : "Waypoint"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.opengis.net/ont/geosparql#Feature"
  } ]
}, {
  "@id" : "https://edint.es/def/vehiculos-compartidos#closureDate",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Date when the station ceases operation."
  }, {
    "@language" : "es",
    "@value" : "Fecha en la cual la estación cesa sus operaciones."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://edint.es/def/vehiculos-compartidos#SharedVehicleStation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "closure date"
  }, {
    "@language" : "es",
    "@value" : "fecha de baja"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#date"
  } ]
}, {
  "@id" : "https://edint.es/def/vehiculos-compartidos#comissioningDate",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "Fecha en que la estación es certificada y puesta en servicio oficialmente."
  }, {
    "@value" : "Date when the station is officially tested, certified, and put into active service."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://edint.es/def/vehiculos-compartidos#SharedVehicleStation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "comissionning date"
  }, {
    "@language" : "es",
    "@value" : "fecha de alta"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#date"
  } ]
}, {
  "@id" : "https://edint.es/def/vehiculos-compartidos#destinationDock",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "es",
    "@value" : "El anclaje de una estación a donde finaliza una ruta de un vehículo."
  }, {
    "@language" : "en",
    "@value" : "The dock in a station where a vehicle's route ends."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://edint.es/def/vehiculos-compartidos#Route"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "destination dock"
  }, {
    "@language" : "es",
    "@value" : "tiene anclaje destino"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://edint.es/def/vehiculos-compartidos#Dock"
  } ]
}, {
  "@id" : "https://edint.es/def/vehiculos-compartidos#destinationSpot",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Parking spot where a vehicle's route ends."
  }, {
    "@language" : "es",
    "@value" : "Plaza de aparcamiento en donde finaliza la ruta de un vehículo."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://edint.es/def/vehiculos-compartidos#Route"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "destination parking spot"
  }, {
    "@language" : "es",
    "@value" : "plaza de aparcamiento estino"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://edint.es/def/aparcamiento#ParkingSpot"
  } ]
}, {
  "@id" : "https://edint.es/def/vehiculos-compartidos#dockAvailability",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://edint.es/def/vehiculos-compartidos#DockProperty"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
