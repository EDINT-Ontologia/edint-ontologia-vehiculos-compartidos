@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix edintvehcom: <https://edint.es/def/vehiculos-compartidos#> .
@prefix edintkos: <https://edint.es/kos/> .
@prefix edintdockstate: <https://edint.es/kos/DockState/> .

#################################################################
#
#    Concept Scheme
#
#################################################################

edintkos:DockState a skos:ConceptScheme ;
  dct:issued "2026-05-21"^^xsd:date ;
  dct:modified "2026-05-21"^^xsd:date ;
  rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the ontologies from the EDINT data space."@en ;
  rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por las ontologías del espacio de datos EDINT."@es ;
  rdfs:label "Dock state"@en ;
  rdfs:label "Estado del anclaje"@es ;
  dct:title "Concept scheme grouping dock states"@en ;
  dct:title "Esquema de conceptos agrupando estados de anclaje"@es .

#################################################################
#
#    Concepts
#
#################################################################

edintdockstate:Active a skos:Concept ;
  skos:inScheme edintkos:DockState ;
  skos:prefLabel "Active"@en ;
  skos:prefLabel "Activo"@es .

edintdockstate:Inactive a skos:Concept ;
  skos:inScheme edintkos:DockState ;
  skos:prefLabel "Inactive"@en ;
  skos:prefLabel "Inactivo"@es .
