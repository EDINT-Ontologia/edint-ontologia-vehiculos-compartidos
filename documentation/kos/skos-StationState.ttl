@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix edintvehcom: <http://vocab.linkeddata.es/datosabiertos/def/transporte/vehiculos-compartidos#> .
@prefix edintkos: <http://vocab.linkeddata.es/datosabiertos/kos/edint/> .
@prefix edintstationstate: <http://vocab.linkeddata.es/datosabiertos/kos/edint/StationState/> .

#################################################################
#
#    Concept Scheme
#
#################################################################

edintkos:StationState a skos:ConceptScheme ;
  dct:issued "2026-05-21"^^xsd:date ;
  dct:modified "2026-05-21"^^xsd:date ;
  rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the ontologies from the EDINT data space."@en ;
  rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por las ontologías del espacio de datos EDINT."@es ;
  rdfs:label "Station state"@en ;
  rdfs:label "Estado de la estación"@es ;
  dct:title "Concept scheme grouping station states"@en ;
  dct:title "Esquema de conceptos agrupando estados de estación"@es .

#################################################################
#
#    Concepts
#
#################################################################

edintstationstate:Operative a skos:Concept ;
  skos:inScheme edintkos:StationState ;
  skos:prefLabel "Operative"@en ;
  skos:prefLabel "Operativa"@es .

edintstationstate:NotOperative a skos:Concept ;
  skos:inScheme edintkos:StationState ;
  skos:prefLabel "Not operative"@en ;
  skos:prefLabel "No operativa"@es .
